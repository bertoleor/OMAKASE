# Variables de entorno de OMAKASE — copiar a .env.local y completar con valores reales.
# Solo NOMBRES; nunca commitear valores.

# --- Supabase (cliente web, NEXT_PUBLIC_ = expone al browser por diseño) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-side, NUNCA exponer al browser) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# --- Email transaccional (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Webhooks ---
WEBHOOK_SECRET=

# --- URL pública de la app (usada en links de emails, etc.) ---
NEXT_PUBLIC_BASE_URL=

# --- Build/bundle analysis (opcional, sin valor = off) ---
ANALYZE=

# --- Edge functions de Supabase (configuradas en el dashboard de Supabase, no en .env del repo) ---
# RESEND_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, EMAIL_FROM
